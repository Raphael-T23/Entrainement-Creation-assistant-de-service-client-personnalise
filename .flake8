[flake8]
max-line-length = 100

exclude = 
    .git
    __pycache__
    venv
    .venv
    build
    dist
    *.egg-info
    .tox
    .pytest_cache
    htmlcov
    orders.db
    users.csv
    orders.csv

# Ignorer les erreurs de style et docstrings
ignore = 
    E203
    E501
    W503
    W504
    E402

# Ignorer certaines erreurs spécifiques
per-file-ignores =
    src/__init__.py:F401,W391
    tests/__init__.py:F401,W391
