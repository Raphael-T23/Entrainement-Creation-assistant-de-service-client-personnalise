# Clé API OpenAI - Requise pour le fonctionnement du bot (ignorée si MOCK_LLM=true)
OPENAI_API_KEY=sk-your-api-key-here

# Modèle OpenAI à utiliser (par défaut : gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Chemin vers la base de données SQLite (par défaut : orders.db)
DATABASE_PATH=orders.db

# --- Mode test sans clé API ---
# Mettre à true pour utiliser un faux LLM (FakeChatOpenAI) au lieu d'OpenAI.
# Permet de tester le bot gratuitement sans clé API.
# En production, cette variable doit rester à false (ou être absente).
MOCK_LLM=false
